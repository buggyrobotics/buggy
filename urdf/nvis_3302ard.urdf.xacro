<?xml version="1.0"?>
<robot name="nvis_3302ard" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find buggy)/urdf/nvis_3302ard.ros2_control.urdf.xacro"/>

  <xacro:property name="chassis_length" value="0.30"/>
  <xacro:property name="chassis_width"  value="0.30"/>
  <xacro:property name="chassis_height" value="0.2"/>
  <xacro:property name="total_mass"     value="1.0"/>

  <xacro:property name="robot_collision_radius" value="0.14"/>

  <xacro:property name="wheel_radius"     value="0.0325"/>
  <xacro:property name="wheel_width"      value="0.026"/>
  <xacro:property name="wheel_separation" value="0.180"/>
  <xacro:property name="caster_offset_x"  value="-0.070"/>

  <xacro:property name="caster_radius" value="0.012"/>
  <xacro:property name="chassis_ground_clearance" value="0.005"/>

  <xacro:property name="wheel_mass"  value="0.05"/>
  <xacro:property name="caster_mass" value="0.15"/>
  <xacro:property name="chassis_mass" value="${total_mass - 2*wheel_mass - caster_mass}"/>

  <xacro:property name="axle_z" value="${wheel_radius}"/>
  <xacro:property name="chassis_z" value="${axle_z + chassis_height/2.0 - chassis_ground_clearance}"/>

  <xacro:property name="lidar_standoff" value="0.03"/>
  <xacro:property name="lidar_horizontal_fov" value="${pi}"/>
  <xacro:property name="lidar_samples" value="180"/>

  <material name="chassis_grey">
    <color rgba="0.6 0.6 0.6 1.0"/>
  </material>
  <material name="dark_grey">
    <color rgba="0.2 0.2 0.2 1.0"/>
  </material>

  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${axle_z}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${chassis_z - axle_z}" rpy="0 0 0"/>
      <geometry><box size="${chassis_length} ${chassis_width} ${chassis_height}"/></geometry>
      <material name="chassis_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${chassis_z - axle_z}" rpy="0 0 0"/>
      <geometry><box size="${chassis_length} ${chassis_width} ${chassis_height}"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${chassis_z - axle_z}" rpy="0 0 0"/>
      <mass value="${chassis_mass}"/>
      <inertia
        ixx="${chassis_mass/12.0*(chassis_width*chassis_width + chassis_height*chassis_height)}" ixy="0" ixz="0"
        iyy="${chassis_mass/12.0*(chassis_length*chassis_length + chassis_height*chassis_height)}" iyz="0"
        izz="${chassis_mass/12.0*(chassis_length*chassis_length + chassis_width*chassis_width)}"/>
    </inertial>
  </link>

  <xacro:macro name="wheel" params="prefix reflect">
    <link name="${prefix}_wheel">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2.0} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="dark_grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2.0} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <inertial>
        <mass value="${wheel_mass}"/>
        <inertia
          ixx="${wheel_mass/12.0*(3*wheel_radius*wheel_radius + wheel_width*wheel_width)}" ixy="0" ixz="0"
          iyy="${wheel_mass/2.0*wheel_radius*wheel_radius}" iyz="0"
          izz="${wheel_mass/12.0*(3*wheel_radius*wheel_radius + wheel_width*wheel_width)}"/>
      </inertial>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel"/>
      <origin xyz="0 ${reflect * wheel_separation/2.0} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.05" friction="0.0"/>
    </joint>
  </xacro:macro>

  <xacro:wheel prefix="left" reflect="1"/>
  <xacro:wheel prefix="right" reflect="-1"/>

  <link name="caster_wheel">
    <visual>
      <geometry><sphere radius="${caster_radius}"/></geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <geometry><sphere radius="${caster_radius}"/></geometry>
    </collision>
    <inertial>
      <mass value="${caster_mass}"/>
      <inertia
        ixx="${2.0/5.0*caster_mass*caster_radius*caster_radius}" ixy="0" ixz="0"
        iyy="${2.0/5.0*caster_mass*caster_radius*caster_radius}" iyz="0"
        izz="${2.0/5.0*caster_mass*caster_radius*caster_radius}"/>
    </inertial>
  </link>

  <joint name="caster_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_wheel"/>
    <origin xyz="${caster_offset_x} 0 ${caster_radius - axle_z}" rpy="0 0 0"/>
  </joint>

  <!-- ================= LiDAR ================= -->
  <xacro:macro name="crowd_nav_lidar"
               params="parent_link
                       xyz:='0 0 0' rpy:='0 0 0'
                       range_min:=0.12
                       range_max:=8.0
                       update_rate:=5.0
                       samples:=360
                       horizontal_fov:=6.28318530718
                       range_noise_stddev:=0.02
                       mount_radius:=0.02
                       mount_height:=0.02">

    <link name="lidar_link">
      <visual>
        <geometry><cylinder radius="${mount_radius}" length="${mount_height}"/></geometry>
        <material name="dark_grey"/>
      </visual>
      <collision>
        <geometry><cylinder radius="${mount_radius}" length="${mount_height}"/></geometry>
      </collision>
      <inertial>
        <mass value="0.02"/>
        <inertia
          ixx="${0.02/12.0*(3*mount_radius*mount_radius + mount_height*mount_height)}" ixy="0" ixz="0"
          iyy="${0.02/12.0*(3*mount_radius*mount_radius + mount_height*mount_height)}" iyz="0"
          izz="${0.02/2.0*mount_radius*mount_radius}"/>
      </inertial>
    </link>

    <joint name="lidar_joint" type="fixed">
      <parent link="${parent_link}"/>
      <child link="lidar_link"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>

    <gazebo reference="lidar_link">
      <sensor name="lidar" type="gpu_lidar">
        <pose>0 0 0 0 0 0</pose>
        <update_rate>${update_rate}</update_rate>
        <topic>scan</topic>
        <gz_frame_id>lidar_link</gz_frame_id>
        <lidar>
          <scan>
            <horizontal>
              <samples>${samples}</samples>
              <resolution>1</resolution>
              <min_angle>${-horizontal_fov/2.0}</min_angle>
              <max_angle>${horizontal_fov/2.0}</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0.0</min_angle>
              <max_angle>0.0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>${range_min}</min>
            <max>${range_max}</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>${range_noise_stddev}</stddev>
          </noise>
        </lidar>
        <always_on>true</always_on>
        <visualize>false</visualize>
      </sensor>
    </gazebo>
  </xacro:macro>

  <xacro:crowd_nav_lidar
    parent_link="base_link"
    xyz="0 0 ${chassis_z - axle_z + chassis_height/2.0 + lidar_standoff}"
    rpy="0 0 0"
    horizontal_fov="${lidar_horizontal_fov}"
    samples="${lidar_samples}"/>

  <xacro:nvis_3302ard_ros2_control/>

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find buggy)/config/diff_drive_controller.yaml</parameters>
    </plugin>
  </gazebo>

  <gazebo reference="base_link">
    <material>Gazebo/Grey</material>
  </gazebo>

  <gazebo reference="caster_wheel">
    <mu1>0.001</mu1>
    <mu2>0.001</mu2>
  </gazebo>

  <gazebo reference="left_wheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>
  <gazebo reference="right_wheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>

</robot>